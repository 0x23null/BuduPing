<Window x:Class="BuduPing.Ui.ReplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BuduPing — Gửi đáp lại" Width="352" Height="356"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI" Foreground="#382923">
    <Window.Resources>
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="2,6"/>
            <Setter Property="Background" Value="#F5E5DB"/><Setter Property="BorderBrush" Value="#E5D6CE"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Frame" CornerRadius="11" Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#F6DDE6"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.7"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#A93F65"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Background="#FFF9F4" BorderBrush="#E8D9D2" BorderThickness="1" CornerRadius="14" Margin="6" Padding="14,12">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="Gửi đáp lại" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Esc đóng" FontSize="11" Foreground="#746057" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <UniformGrid x:Name="TileGrid" Columns="4" Rows="3"/>
            <Grid Margin="0,8,0,0">
                <TextBox x:Name="MessageBox" MaxLength="80" MinHeight="38" Padding="10,8" FontSize="13" VerticalContentAlignment="Center"
                    Background="White" BorderBrush="#E5D6CE" BorderThickness="1" TextChanged="MessageBox_TextChanged"
                    AutomationProperties.Name="Lời nhắn kèm theo">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                    </TextBox.Resources>
                </TextBox>
                <TextBlock x:Name="Placeholder" Text="Lời nhắn kèm theo (tuỳ chọn)" FontSize="13" Foreground="#A08C83"
                    Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock x:Name="Hint" FontSize="11" Foreground="#746057" Margin="2,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
