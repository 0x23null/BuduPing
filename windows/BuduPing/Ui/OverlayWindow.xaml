<Window x:Class="BuduPing.Ui.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BuduPing Overlay"
        Width="380" Height="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Visibility="Collapsed">
    <Grid x:Name="Root">
        <!-- Lớp hạt: vẽ sau (dưới) sticker nhưng vẫn trong cửa sổ overlay -->
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False"/>

        <StackPanel x:Name="ContentPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,1" Opacity="0">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ContentScale" ScaleX="0.6" ScaleY="0.6"/>
                    <TranslateTransform x:Name="ContentSlide" Y="24"/>
                </TransformGroup>
            </StackPanel.RenderTransform>

            <!-- Bong bóng chat: bo góc + đuôi chĩa xuống sticker -->
            <StackPanel x:Name="BubbleWrap" HorizontalAlignment="Center" Margin="0,0,0,4">
                <Border x:Name="Bubble" Background="#F5FFFFFF" CornerRadius="18"
                        Padding="16,11" MaxWidth="330" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.30" Color="#666666"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="BubbleHeader" FontSize="16" FontWeight="Bold"
                                   Foreground="#D94F70" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BubbleText" FontSize="20" Foreground="#2B2B2B"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Path x:Name="BubbleTail" Data="M0,0 L18,0 L9,13 Z" Fill="#F5FFFFFF"
                      HorizontalAlignment="Center" Margin="0,-1,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Thẻ nền sáng sau sticker: quầng sáng ở v0.1.2 KHÔNG đủ cứu nền desktop
                 tối (user xác nhận vẫn chìm) → đặt hẳn 1 tấm thẻ trắng-hồng mờ 95% sau
                 sticker, như thẻ thông báo: nền nào sticker cũng đọc rõ. Quầng sáng
                 hồng giữ lại bên trong thẻ cho mềm. -->
            <Border CornerRadius="26" Padding="18,14,18,16" HorizontalAlignment="Center"
                    BorderBrush="#FFFFCFE0" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F2FFFFFF" Offset="0"/>
                        <GradientStop Color="#F2FFF0F6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.25" Color="#8A5A6E"/>
                </Border.Effect>
            <Grid HorizontalAlignment="Center">
                <Ellipse Width="330" Height="330" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#59FFE9F2" Offset="0"/>
                            <GradientStop Color="#33FFC7DC" Offset="0.55"/>
                            <GradientStop Color="#00FFC7DC" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Image x:Name="StickerImage" Width="264" Height="264" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#FF9EC7"/>
                    </Image.Effect>
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="StickerScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="StickerShake"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Border x:Name="ComboBadge" Background="#FF5C8A" CornerRadius="16" Padding="13,5"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,2,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ComboBadgeText" Text="x3" FontSize="24"
                               FontWeight="Bold" Foreground="White"/>
                </Border>
            </Grid>
            </Border>
            <Rectangle Height="10" Fill="Transparent"/>
        </StackPanel>
    </Grid>
</Window>
