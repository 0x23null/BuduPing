<Window x:Class="BuduPing.Ui.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BuduPing Overlay"
        Width="380" Height="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Visibility="Collapsed">
    <Grid x:Name="Root" Width="380" Height="580" HorizontalAlignment="Center" VerticalAlignment="Bottom">
        <!-- Lớp hạt: vẽ sau (dưới) sticker nhưng vẫn trong cửa sổ overlay -->
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False"/>

        <StackPanel x:Name="ContentPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,1" Opacity="0">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ContentScale" ScaleX="0.6" ScaleY="0.6"/>
                    <TranslateTransform x:Name="ContentSlide" Y="24"/>
                </TransformGroup>
            </StackPanel.RenderTransform>

            <!-- Bong bóng chat: bo góc + đuôi chĩa xuống sticker -->
            <StackPanel x:Name="BubbleWrap" HorizontalAlignment="Center" Margin="0,0,0,4">
                <Border x:Name="Bubble" Background="#F5FFFFFF" CornerRadius="18"
                        Padding="16,11" MaxWidth="330" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.30" Color="#666666"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="BubbleHeader" FontSize="14" FontWeight="Bold"
                                   Foreground="#A93F65" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BubbleText" FontSize="17" Foreground="#2B2B2B"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Path x:Name="BubbleTail" Data="M0,0 L18,0 L9,13 Z" Fill="#F5FFFFFF"
                      HorizontalAlignment="Center" Margin="0,-1,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Sticker GIF trong suốt + quầng sáng hồng sau lưng: trên nền desktop tối
                 sticker viền tối + bóng đổ tối sẽ chìm; quầng sáng này giúp sticker
                 luôn nổi rõ cả nền sáng lẫn tối -->
            <Grid HorizontalAlignment="Center">
                <Ellipse Width="330" Height="330" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#59FFE9F2" Offset="0"/>
                            <GradientStop Color="#33FFC7DC" Offset="0.55"/>
                            <GradientStop Color="#00FFC7DC" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Grid x:Name="StickerStage" Width="264" Height="264" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><TransformGroup>
                        <ScaleTransform x:Name="StickerScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="StickerShake"/>
                        <RotateTransform x:Name="StickerTilt"/>
                    </TransformGroup></Grid.RenderTransform>
                    <Canvas Width="264" Height="264" ClipToBounds="True">
                <Image x:Name="StickerImage" Width="264" Height="264" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#FF9EC7"/>
                    </Image.Effect>
                </Image>
                    </Canvas>
                </Grid>
                <Border x:Name="ComboBadge" Background="#A93F65" CornerRadius="14" Padding="10,4"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,2,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ComboBadgeText" Text="x3" FontSize="19"
                               FontWeight="Bold" Foreground="White"/>
                </Border>
            </Grid>
            <Rectangle Height="10" Fill="Transparent"/>
        </StackPanel>
    </Grid>
</Window>
