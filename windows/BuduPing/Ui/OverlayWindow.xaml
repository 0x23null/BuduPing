<Window x:Class="BuduPing.Ui.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BuduPing Overlay"
        Width="520" Height="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Visibility="Collapsed">
    <Grid x:Name="Root" Width="520" Height="580" HorizontalAlignment="Center" VerticalAlignment="Bottom">
        <!-- Lớp hạt: vẽ sau (dưới) sticker nhưng vẫn trong cửa sổ overlay -->
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False"/>

        <StackPanel x:Name="ContentPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,1" Opacity="0">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ContentScale" ScaleX="0.6" ScaleY="0.6"/>
                    <RotateTransform x:Name="ContentTilt" Angle="0"/>
                    <TranslateTransform x:Name="ContentSlide" Y="24"/>
                </TransformGroup>
            </StackPanel.RenderTransform>

            <!-- Bong bóng chat: bo góc + đuôi chĩa xuống sticker -->
            <StackPanel x:Name="BubbleWrap" HorizontalAlignment="Center" Margin="0,0,0,4" RenderTransformOrigin="0.5,1">
                <StackPanel.RenderTransform><ScaleTransform x:Name="BubbleScale"/></StackPanel.RenderTransform>
                <Border x:Name="Bubble" Background="#F22E2B3A" BorderBrush="#5A5478" BorderThickness="1" CornerRadius="20"
                        Padding="14,12,16,12" MaxWidth="348" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Color="#8A5A6A"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border x:Name="BubbleHeartChip" Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF9EC2" Offset="0"/><GradientStop Color="#CE4A7C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="M 10,18 C -7,6 1,-5 10,3 C 19,-5 27,6 10,18 Z" Fill="#FFFFFF" Stretch="Uniform" Width="14" Height="13"/>
                            </Border>
                            <Border x:Name="BubbleAvatarChip" Width="26" Height="26" CornerRadius="13" Visibility="Collapsed" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFE9F4" Offset="0"/><GradientStop Color="#FFC7DC" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Image x:Name="BubbleAvatar" Width="24" Height="24" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.Clip><EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12"/></Image.Clip>
                                </Image>
                            </Border>
                            <TextBlock x:Name="BubbleFrom" Grid.Column="1" FontSize="13" FontWeight="SemiBold" FontFamily="pack://application:,,,/Assets/Fonts/Baloo2.ttf#Baloo 2"
                                Foreground="#FFD9E6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" MaxWidth="170"/>
                            <TextBlock x:Name="BubbleEmotion" Grid.Column="2" FontSize="11" Foreground="#C9C3E6" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="BubbleText" FontSize="19" LineHeight="28" Foreground="#FFFFFF"
                                   FontFamily="pack://application:,,,/Assets/Fonts/Baloo2.ttf#Baloo 2, Segoe UI Emoji, Segoe UI" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Path x:Name="BubbleTail" Data="M0,0 L18,0 L9,13 Z" Fill="#F22E2B3A"
                      HorizontalAlignment="Center" Margin="0,-1,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Full transparent background: no card plate and no glow disc behind
                 the sticker. The buddy sits directly on the desktop; only the
                 sticker's own soft shadow remains for separation. -->
            <Border x:Name="StickerCard" CornerRadius="26" Padding="18,14,18,0" HorizontalAlignment="Center"
                    Background="Transparent" BorderThickness="0">
            <Grid HorizontalAlignment="Center">
                <Ellipse x:Name="StickerGlow" Width="330" Height="330" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#59FFE9F2" Offset="0"/>
                            <GradientStop Color="#33FFC7DC" Offset="0.55"/>
                            <GradientStop Color="#00FFC7DC" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Grid x:Name="StickerStage" Width="264" Height="264" RenderTransformOrigin="0.5,1">
                    <Grid.RenderTransform><TransformGroup>
                        <ScaleTransform x:Name="StickerScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="StickerShake"/>
                        <RotateTransform x:Name="StickerTilt"/>
                    </TransformGroup></Grid.RenderTransform>
                    <Canvas Width="264" Height="264" ClipToBounds="True">
                <Image x:Name="StickerImage" Width="264" Height="264" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5"/>
                    </Canvas>
                </Grid>
                <Border x:Name="ComboBadge" Background="#A93F65" CornerRadius="16" Padding="13,5"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,2,0"
                        Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="BadgeScale"/></Border.RenderTransform>
                    <TextBlock x:Name="ComboBadgeText" Text="x3" FontSize="32"
                               FontWeight="Bold" Foreground="White"/>
                </Border>
            </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
