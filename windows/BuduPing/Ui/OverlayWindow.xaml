<Window x:Class="BuduPing.Ui.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BuduPing Overlay"
        Width="520" Height="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Visibility="Collapsed">
    <Grid x:Name="Root" Width="520" Height="580" HorizontalAlignment="Center" VerticalAlignment="Bottom">
        <!-- Lớp hạt: vẽ sau (dưới) sticker nhưng vẫn trong cửa sổ overlay -->
        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False"/>

        <StackPanel x:Name="ContentPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,1" Opacity="0">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ContentScale" ScaleX="0.6" ScaleY="0.6"/>
                    <RotateTransform x:Name="ContentTilt" Angle="0"/>
                    <TranslateTransform x:Name="ContentSlide" Y="24"/>
                </TransformGroup>
            </StackPanel.RenderTransform>

            <!-- Bong bóng chat: bo góc + đuôi chĩa xuống sticker -->
            <StackPanel x:Name="BubbleWrap" HorizontalAlignment="Center" Margin="0,0,0,4" RenderTransformOrigin="0.5,1">
                <StackPanel.RenderTransform><ScaleTransform x:Name="BubbleScale"/></StackPanel.RenderTransform>
                <Border x:Name="Bubble" Background="#FAFFFFFF" CornerRadius="20"
                        Padding="14,12,16,12" MaxWidth="348" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Color="#8A5A6A"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top" Margin="0,1,11,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F77CA6" Offset="0"/>
                                    <GradientStop Color="#CE4A7C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock x:Name="BubbleAvatar" Text="❤" FontSize="17" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="BubbleFrom" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#8A2F4E" VerticalAlignment="Center"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                <Border Background="#FCE4EE" CornerRadius="8" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="BubbleEmotion" FontSize="11" FontWeight="SemiBold" Foreground="#B03A63"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="BubbleText" FontSize="20" Foreground="#33262C"
                                       FontFamily="Segoe UI Variable Text, Segoe UI" LineHeight="27"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Path x:Name="BubbleTail" Data="M0,0 L18,0 L9,13 Z" Fill="#FAFFFFFF"
                      HorizontalAlignment="Center" Margin="0,-1,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Thẻ nền sáng sau sticker: quầng sáng ở v0.1.2 KHÔNG đủ cứu nền desktop
                 tối (user xác nhận vẫn chìm) → đặt hẳn 1 tấm thẻ trắng-hồng mờ 95% sau
                 sticker, như thẻ thông báo: nền nào sticker cũng đọc rõ. Quầng sáng
                 hồng giữ lại bên trong thẻ cho mềm. -->
            <Border CornerRadius="26" Padding="18,14,18,16" HorizontalAlignment="Center"
                    BorderBrush="#FFFFCFE0" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F2FFFFFF" Offset="0"/>
                        <GradientStop Color="#F2FFF0F6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.25" Color="#8A5A6E"/>
                </Border.Effect>
            <Grid HorizontalAlignment="Center">
                <Ellipse x:Name="StickerGlow" Width="330" Height="330" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#59FFE9F2" Offset="0"/>
                            <GradientStop Color="#33FFC7DC" Offset="0.55"/>
                            <GradientStop Color="#00FFC7DC" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Grid x:Name="StickerStage" Width="264" Height="264" RenderTransformOrigin="0.5,1">
                    <Grid.RenderTransform><TransformGroup>
                        <ScaleTransform x:Name="StickerScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="StickerShake"/>
                        <RotateTransform x:Name="StickerTilt"/>
                    </TransformGroup></Grid.RenderTransform>
                    <Canvas Width="264" Height="264" ClipToBounds="True">
                <Image x:Name="StickerImage" Width="264" Height="264" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#FF9EC7"/>
                    </Image.Effect>
                </Image>
                    </Canvas>
                </Grid>
                <Border x:Name="ComboBadge" Background="#A93F65" CornerRadius="16" Padding="13,5"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,2,0"
                        Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="BadgeScale"/></Border.RenderTransform>
                    <TextBlock x:Name="ComboBadgeText" Text="x3" FontSize="24"
                               FontWeight="Bold" Foreground="White"/>
                </Border>
            </Grid>
            </Border>
            <Rectangle Height="10" Fill="Transparent"/>
        </StackPanel>
    </Grid>
</Window>
