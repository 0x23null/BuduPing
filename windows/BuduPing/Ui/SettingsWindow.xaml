<Window x:Class="BuduPing.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BuduPing — Cài đặt" Width="460" Height="760" MinHeight="400"
        Background="#FFF9F4" Foreground="#382923" FontFamily="Segoe UI"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/><Setter Property="MinHeight" Value="44"/>
            <Setter Property="Background" Value="#F5E5DB"/><Setter Property="Foreground" Value="#382923"/>
            <Setter Property="BorderBrush" Value="#E5D6CE"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Frame" CornerRadius="11" Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.88"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.70"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#A93F65"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="44"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Background="Transparent" MinHeight="44">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11" Background="#D9C7C0" BorderThickness="1" BorderBrush="Transparent" VerticalAlignment="Center">
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" Margin="2,0" HorizontalAlignment="Left"/>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#A93F65"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#382923"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemFrame" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#F9EFE7"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#F6DDE6"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="42"/><Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E5D6CE"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                                <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#746057" StrokeThickness="1.5" Width="8" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            </Border>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                        ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center" Margin="12,0,36,0"/>
                    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Background="White" CornerRadius="10" BorderBrush="#E5D6CE" BorderThickness="1" Padding="4" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                            <ScrollViewer MaxHeight="260" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#A93F65"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Background="#FFF9F4">
    <StackPanel Margin="28,24">
        <TextBlock Text="BuduPing" FontSize="28" FontWeight="SemiBold"/>
        <Border Background="White" CornerRadius="16" Padding="16" BorderBrush="#E5D6CE" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Mã ghép cặp" Foreground="#746057"/>
                <TextBlock x:Name="CodeText" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center"
                    FontFamily="Consolas" Foreground="#A93F65" Margin="0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="CopyButton" Content="Sao chép mã" Click="CopyButton_Click" Margin="0,0,8,0"/>
                    <Button Content="Đổi mã" Click="RegenButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock Text="Trải nghiệm" FontWeight="SemiBold" FontSize="17" Margin="0,24,0,4"/>
        <CheckBox x:Name="SoundCheck" Content="Âm thanh cảm xúc" Checked="SoundCheck_Changed" Unchecked="SoundCheck_Changed"/>
        <CheckBox x:Name="AutostartCheck" Content="Chạy cùng Windows" Checked="AutostartCheck_Changed" Unchecked="AutostartCheck_Changed"/>
        <CheckBox x:Name="DiscreetCheck" Content="Kín đáo: sticker nhỏ, giữ lời nhắn để xem sau" Checked="Preferences_Changed" Unchecked="Preferences_Changed"/>
        <CheckBox x:Name="PrivacyCheck" Content="Ẩn nội dung lời nhắn trên desktop" Checked="Preferences_Changed" Unchecked="Preferences_Changed"/>
        <CheckBox x:Name="MotionCheck" Content="Giảm chuyển động và hiệu ứng hạt" Checked="Preferences_Changed" Unchecked="Preferences_Changed"/>
        <TextBlock Text="Bạn là" FontWeight="SemiBold" FontSize="17" Margin="0,20,0,8"/>
        <ComboBox x:Name="CharacterCombo" SelectedValuePath="Tag" SelectionChanged="Character_Changed" AutomationProperties.Name="Nhân vật của bạn">
            <ComboBoxItem Content="Bubu · gấu trắng" Tag="bubu"/>
            <ComboBoxItem Content="Dudu · gấu nâu" Tag="dudu"/>
            <ComboBoxItem Content="Cả hai (không lọc sticker)" Tag=""/>
        </ComboBox>
        <TextBlock Text="Sticker bạn gửi đáp lại (Ctrl+Alt+Space) sẽ theo nhân vật này." Foreground="#746057" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBlock Text="Vị trí sticker" FontWeight="SemiBold" FontSize="17" Margin="0,20,0,8"/>
        <TextBlock Text="Màn hình" Foreground="#746057"/>
        <ComboBox x:Name="MonitorCombo" SelectionChanged="Placement_Changed" AutomationProperties.Name="Màn hình hiển thị sticker">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Góc hiển thị" Foreground="#746057"/>
        <ComboBox x:Name="CornerCombo" SelectedValuePath="Tag" SelectionChanged="Placement_Changed" AutomationProperties.Name="Góc hiển thị">
            <ComboBoxItem Content="Dưới bên phải" Tag="BottomRight"/><ComboBoxItem Content="Dưới bên trái" Tag="BottomLeft"/>
            <ComboBoxItem Content="Trên bên phải" Tag="TopRight"/><ComboBoxItem Content="Trên bên trái" Tag="TopLeft"/>
        </ComboBox>
        <TextBlock Text="Kích thước" Foreground="#746057"/>
        <ComboBox x:Name="ScaleCombo" SelectedValuePath="Tag" SelectionChanged="Placement_Changed" AutomationProperties.Name="Kích thước sticker">
            <ComboBoxItem Content="Nhỏ" Tag="0.6"/><ComboBoxItem Content="Vừa" Tag="1"/><ComboBoxItem Content="Lớn" Tag="1.3"/>
        </ComboBox>
        <TextBlock x:Name="HotkeyStatus" TextWrapping="Wrap" Foreground="#746057" Margin="0,12,0,8"/>
        <Button x:Name="ReplyButton" Content="Gửi ôm đáp lại" Click="ReplyButton_Click"/>
        <Button x:Name="PendingButton" Content="Mở xem lời nhắn đang chờ" Click="PendingButton_Click"/>
        <Button Content="Thử sticker" Click="TestButton_Click" Background="#A93F65" Foreground="White"/>
        <TextBlock Text="BuduPing 0.2.2 · Đóng cửa sổ để tiếp tục chạy trong khay hệ thống."
            TextWrapping="Wrap" Foreground="#746057" FontSize="12" Margin="0,16,0,8"/>
    </StackPanel>
    </ScrollViewer>
</Window>
